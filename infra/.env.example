# Copy this file to infra/.env before starting Compose.
# Do not commit infra/.env or replace these values with production secrets.

MINIO_ROOT_USER=local-admin
MINIO_ROOT_PASSWORD=change-this-admin-password
MINIO_STUDENT_ACCESS_KEY=student-user
MINIO_STUDENT_SECRET_KEY=change-this-student-password
JUPYTER_TOKEN=change-this-jupyter-token

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_1_UI_PORT=8081
SPARK_WORKER_2_UI_PORT=8082
JUPYTER_PORT=8888
